# Coverage of the engine, measured in CI only: the engine itself stays standard-library only.
#   pip install coverage
#   coverage run -m unittest discover -s engine/tests && coverage combine && coverage report
# Most of the engine runs as subprocesses (hooks, the brain command), so they are measured too.
[run]
branch = True
parallel = True
patch = subprocess
source =
    engine/lib
    engine/hooks
    engine/bin

[report]
fail_under = 100
show_missing = True
skip_covered = True
exclude_also =
    if __name__ == .__main__.:
