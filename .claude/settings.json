{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Bash(brain *)",
      "Bash(python3 -m unittest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)"
    ]
  },
  "enabledPlugins": {
    "aibrain@aibrain": true
  }
}
