#!/usr/bin/env python3
"""brain: the brain's instruments, on PATH while the aibrain plugin is enabled.

    brain check [--json] [--guard]        broken links, schema, index drift, edited inputs (exit 1 on a defect)
    brain introspect [--queue|--due|...]  health metrics, queues, graph views
    brain search QUERY [--type ...]       pages by their words (BM25), --dormant too
    brain recall QUERY [--project NAME]   words, then association along links; confidence and flags
    brain since FROM [--until TO]         what was made, changed, asked and rehearsed in a period
    brain fingerprint                     record a hash of each new input in senses/
    brain graph [out] [--format ...]      the link graph as CSV or GraphML
    brain export PAGE ... | --published   pages for outside use, into motor/export/
    brain cache [--rebuild|--clear]       the search cache (.cache/search.sqlite): size, rebuild, clear
    brain chats EXPORT OUT [...]          a Claude or ChatGPT export, one file per conversation
    brain eval [--answers FILE] [--json]  the answer test set: retrieval, or answers given by /ask
    brain synth OUT [--pages N]           a synthetic brain of any size, for testing the engine
    brain test                            the engine's own test suite

The brain is the nearest folder at or above the working directory that holds
both cortex/ and hippocampus/ (or $BRAIN_ROOT). Scripts get it as their root.
`eval` and `synth` need no brain: they run on the engine's fixture or a new folder.
"""
import os
import subprocess
import sys

ENGINE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
LIB = os.path.join(ENGINE, "lib")

# subcommand -> (script, how the brain root is passed, arguments put first)
COMMANDS = {
    "check": ("link_check.py", "positional", []),
    "introspect": ("introspect.py", "positional", []),
    "search": ("search.py", "--root", ["search"]),
    "recall": ("search.py", "--root", ["recall"]),
    "since": ("timeline.py", "--root", []),
    "fingerprint": ("fingerprint.py", "positional", []),
    "graph": ("graph_export.py", "positional", []),
    "export": ("export.py", "--root", []),
    "cache": ("cache.py", "positional", []),
    "chats": ("chat_export_to_md.py", None, []),
    "eval": ("eval.py", None, []),
    "synth": ("synth.py", None, []),
}


def find_root():
    if os.environ.get("BRAIN_ROOT"):
        return os.path.abspath(os.environ["BRAIN_ROOT"])
    here = os.getcwd()
    while True:
        if all(os.path.isdir(os.path.join(here, d)) for d in ("cortex", "hippocampus")):
            return here
        parent = os.path.dirname(here)
        if parent == here:
            sys.exit("brain: no brain here (no folder with cortex/ and hippocampus/ at or above this one)")
        here = parent


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    name, args = argv[0], argv[1:]
    if name == "test":
        return subprocess.call([sys.executable, "-m", "unittest", "discover", os.path.join(ENGINE, "tests"), *args])
    if name not in COMMANDS:
        sys.exit(f"brain: unknown command '{name}'; run `brain help`")
    script, root_style, lead = COMMANDS[name]
    cmd = [sys.executable, os.path.join(LIB, script), *lead]
    if root_style:
        root = find_root()
        os.chdir(root)
        cmd += [root] if root_style == "positional" else ["--root", root]
    return subprocess.call(cmd + args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
