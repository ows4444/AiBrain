#!/usr/bin/env python3
"""brain: the brain's instruments, on PATH while the aibrain plugin is enabled.

    brain check [--json] [--guard]        broken links, schema, index drift, edited inputs (exit 1 on a defect)
    brain introspect [--queue|--due|...]  health metrics, queues, graph views
    brain search QUERY [--type ...]       pages by their words (BM25), --dormant too
    brain recall QUERY [--project NAME]   words, then association along links; confidence and flags
    brain since FROM [--until TO]         what was made, changed, asked and rehearsed in a period
    brain log OP [WHAT] [--pages ...]     write one checked line to the log: the operation, the pages, today's date
    brain index [--dry-run]               rewrite the listing of hippocampus/index.md from the pages and their summaries
    brain fingerprint                     record a hash of each new input in senses/
    brain ground FILE | -                 a drafted answer or piece: links, numbers and quotations with no page behind them
    brain graph [out] [--format ...]      the link graph as CSV or GraphML
    brain export PAGE ... | --published   pages for outside use, into motor/export/
    brain errors [--since D] [--tail N]   what the hooks swallowed or refused (.cache/errors.log), for refactoring
    brain cache [--rebuild|--clear]       the search cache (.cache/search.sqlite): size, rebuild, clear
    brain capture TEXT                    one line kept for later: a note in inbox/, which /ingest encodes
    brain fetch URL [--name SLUG]         a web page cut down to its readable text, saved in senses/
    brain extract FILE [--name SLUG]      a PDF's or an image's text into senses/, read by pdftotext or tesseract
    brain fit senses/FILE                 what an input bears on: the pages its own words reach, the held ideas it names
    brain import obsidian VAULT           notes kept in another tool into senses/, one input a note; never overwrites
    brain inbox                           what waits in inbox/, sorted: ready, duplicate, credential, forgotten, not text
    brain new TYPE [--from senses/FILE]   a page from its template, frontmatter filled in from the input
    brain mcp                             a read-only MCP server on stdin and stdout, for other programs: search, recall, since, gaps
    brain chats EXPORT OUT [...]          a Claude or ChatGPT export, one file per conversation
    brain session [TRANSCRIPT]            what the owner typed in this conversation, for /ingest session
    brain forget SOURCE [--yes]           what rests on one input; with the owner's yes, remove it and its episodes
    brain restore NAME [--dry-run]        bring a faded page back from dormant/ to cortex/ and the index; the move is logged
    brain resume                          write where the work stands to the active project's process/resume.md
    brain statusline [--bar]              the queues and context fill on one line; --bar is the short form for Claude Code's row
    brain tend --check                    everything that needs the owner, in one read-only digest: safe to run on a schedule
    brain eval [--from-log] [--set N=V]   the answer test set, or with --from-log every question in the log replayed; --set tries a threshold
    brain synth OUT [--pages N]           a synthetic brain of any size, for testing the engine
    brain bench [--pages N] [--json]      how long each instrument takes on a synthetic brain: run before and after a change
    brain test [-v] [-k PATTERN]          the engine's own test suite

The brain is the nearest folder at or above the working directory that holds
both cortex/ and hippocampus/ (or $BRAIN_ROOT). A command works from that folder.
`eval`, `synth`, `bench` and `chats` need no brain: they run on the engine's fixture or on the paths given.
`mcp` starts without one too, and then offers no tools.
Every command takes --json: what it found or did as data, in place of the text.
Another program calls a command the same way, without a process: see lib/commands.py.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import commands  # noqa: E402

if __name__ == "__main__":
    sys.exit(commands.main(sys.argv[1:], __doc__))
